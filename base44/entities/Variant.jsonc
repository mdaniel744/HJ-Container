{
  "name": "Variant",
  "type": "object",
  "properties": {
    "product_key": {
      "type": "string"
    },
    "item_group_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "10ft",
        "20ft",
        "40ft"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used"
      ]
    },
    "color_da": {
      "type": "string"
    },
    "color_en": {
      "type": "string"
    },
    "ral_code": {
      "type": "string"
    },
    "door_type_da": {
      "type": "string"
    },
    "door_type_en": {
      "type": "string"
    },
    "price_incl_vat": {
      "type": "number",
      "description": "DKK incl. 25% VAT. Empty = price on request"
    },
    "compare_at_price": {
      "type": "number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "on_request",
        "backorder"
      ],
      "default": "on_request"
    },
    "stock_quantity": {
      "type": "number"
    },
    "depot": {
      "type": "string"
    },
    "lead_time_da": {
      "type": "string"
    },
    "lead_time_en": {
      "type": "string"
    },
    "external_dimensions": {
      "type": "string"
    },
    "internal_dimensions": {
      "type": "string"
    },
    "door_opening": {
      "type": "string"
    },
    "tare_weight": {
      "type": "string"
    },
    "max_payload": {
      "type": "string"
    },
    "internal_volume": {
      "type": "string"
    },
    "material_da": {
      "type": "string"
    },
    "material_en": {
      "type": "string"
    },
    "floor_da": {
      "type": "string"
    },
    "floor_en": {
      "type": "string"
    },
    "csc_status": {
      "type": "string"
    },
    "wwt_status": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "mpn": {
      "type": "string"
    },
    "gtin": {
      "type": "string"
    },
    "direct_order": {
      "type": "boolean",
      "default": false
    },
    "quote_only": {
      "type": "boolean",
      "default": true
    },
    "merchant_include": {
      "type": "boolean",
      "default": false
    },
    "is_sample": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "product_key",
    "sku",
    "size",
    "condition"
  ]
}