{
  "name": "Faq",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "products",
        "sizes",
        "condition",
        "prices",
        "delivery",
        "unloading",
        "ordering",
        "payment",
        "returns",
        "complaints",
        "quotations"
      ]
    },
    "question_da": {
      "type": "string"
    },
    "answer_da": {
      "type": "string"
    },
    "question_en": {
      "type": "string"
    },
    "answer_en": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "show_on_home": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "category",
    "question_da",
    "answer_da",
    "question_en",
    "answer_en"
  ]
