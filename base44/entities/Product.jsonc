{
  "name": "Product",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Stable product family key"
    },
    "category": {
      "type": "string",
      "enum": [
        "standard",
        "high_cube",
        "open_side"
      ]
    },
    "name_da": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "slug_da": {
      "type": "string"
    },
    "slug_en": {
      "type": "string"
    },
    "short_da": {
      "type": "string"
    },
    "short_en": {
      "type": "string"
    },
    "description_da": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "applications_da": {
      "type": "string"
    },
    "applications_en": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seo_title_da": {
      "type": "string"
    },
    "seo_title_en": {
      "type": "string"
    },
    "seo_description_da": {
      "type": "string"
    },
    "seo_description_en": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_sample": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "category",
    "name_da",
    "name_en",
    "slug_da",
    "slug_en"
  ]
}