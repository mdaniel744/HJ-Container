{
  "name": "PolicyPage",
  "type": "object",
  "properties": {
    "slug_da": {
      "type": "string"
    },
    "slug_en": {
      "type": "string"
    },
    "title_da": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "body_da": {
      "type": "string"
    },
    "body_en": {
      "type": "string"
    },
    "needs_legal_review": {
      "type": "boolean",
      "default": true
    },
    "missing_info": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "slug_da",
    "slug_en",
    "title_da",
    "title_en"
  ]
}