{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "product",
        "delivery",
        "order",
        "return",
        "business",
        "other"
      ],
      "default": "other"
    },
    "message": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "da",
        "en"
      ],
      "default": "da"
    },
    "handled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}