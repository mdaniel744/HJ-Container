{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string"
    },
    "business_hours_da": {
      "type": "string"
    },
    "business_hours_en": {
      "type": "string"
    },
    "notification_email": {
      "type": "string"
    },
    "show_knowledge_centre": {
      "type": "boolean",
      "default": true
    },
    "vat_rate": {
      "type": "number",
      "default": 25
    },
    "show_prices_excl_vat": {
      "type": "boolean",
      "default": true
    },
    "delivery_base_fee": {
      "type": "number",
      "default": 2500
    },
    "delivery_per_km": {
      "type": "number",
      "default": 18
    },
    "crane_truck_fee": {
      "type": "number",
      "default": 1500
    },
    "denmark_handling_min_business_days": {
      "type": "number"
    },
    "denmark_handling_max_business_days": {
      "type": "number"
    },
    "denmark_transit_min_business_days": {
      "type": "number"
    },
    "denmark_transit_max_business_days": {
      "type": "number"
    },
    "consumer_return_transport_max_dkk": {
      "type": "number"
    },
    "payment_deadline_days": {
      "type": "number"
    }
  }
}
