{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "da",
        "en"
      ],
      "default": "da"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "address": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Danmark"
    },
    "site_access": {
      "type": "string"
    },
    "ground_condition": {
      "type": "string"
    },
    "unloading_method": {
      "type": "string"
    },
    "delivery_period": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "cvr": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "quoted",
        "won",
        "lost",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "request_number",
    "email"
  ]
}